# Copy to .env next to docker-compose.yml. Docker Compose reads it automatically.
#
# Only the port and server name usually need changing for a home deployment.
# Put TLS in front of this service (Caddy, nginx, Traefik) before exposing it
# to the internet; the app sends an authentication verifier, never a password.

FLEXIVAULT_PORT=8787
SERVER_NAME=FlexiVault

# Set false after creating your account to stop anyone else registering.
REGISTRATION_OPEN=true

# "*" is fine for the mobile and extension clients, which do not rely on
# cookies. Pin your web origin if you add a browser-based client later.
CORS_ORIGINS=*

# 30 days. Shorter values force more re-authentication.
TOKEN_TTL_SECONDS=2592000

# 8 MiB request cap and 5000 items per vault.
MAX_VAULT_BYTES=8388608
MAX_ITEMS=5000

# Enable only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Optional. If left empty the server generates 32-byte secrets on first start
# and stores them in the data volume (jwt.key / encryption.key). If you pin
# them, use at least 32 random bytes (base64 or text) and keep them stable:
# losing ENCRYPTION_SECRET makes stored server-side 2FA secrets unreadable.
JWT_SECRET=
ENCRYPTION_SECRET=
