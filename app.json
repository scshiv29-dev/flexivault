{
  "expo": {
    "name": "FlexiVault",
    "slug": "flexiauth",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flexivault",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070C0A",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#070C0A"
      },
      "package": "com.shivamchaudhary.flexiauth",
      "versionCode": 4
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "FlexiVault uses Face ID to unlock your encrypted vault."
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#070C0A"
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e1009880-852f-46ec-b04f-ba40af865b5a"
      }
    },
    "owner": "beerpal"
  }
}
